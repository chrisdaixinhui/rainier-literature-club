# ── Notion 内容源（活动数据库）────────────────────────────
NOTION_API_KEY=
NOTION_ACTIVITY_DB_ID=
NOTION_SENTENCE_DB_ID=

# ── 手动刷新缓存（调用 /api/revalidate 时使用）────────────
ADMIN_PASSWORD=

# ── Cloudinary 图片存储（Notion 图片自动转存用）──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rainier/activities

# ── Vercel Cron 鉴权（可选，自动同步任务用）──────────────
CRON_SECRET=

# ── Mailchimp 邮件订阅（Marketing API）────────────────────
# API Key 在 Mailchimp: Account & billing > Extras > API keys
# Audience ID 在 Mailchimp: Audience > Settings > Audience name and defaults
# Server prefix 是 API Key 末尾的 usXX 部分，例如 us21
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
