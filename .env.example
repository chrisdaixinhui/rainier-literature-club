# ── Notion 内容源（活动数据库）────────────────────────────
NOTION_API_KEY=
NOTION_ACTIVITY_DB_ID=

# ── 手动刷新缓存（调用 /api/revalidate 时使用）────────────
ADMIN_PASSWORD=

# ── Cloudinary 图片存储（Notion 图片自动转存用）──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rainier/activities

# ── Vercel Cron 鉴权（可选，自动同步任务用）──────────────
CRON_SECRET=
